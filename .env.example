# Copy to .env and fill in real values. Never commit .env.
# The Riot API key must stay on the backend: it must never be sent to the frontend and
# must never be exposed through a NEXT_PUBLIC_* variable.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3001
LOG_LEVEL=log

# --- Riot Games --------------------------------------------------------------
# Obtain it from https://developer.riotgames.com (development keys expire every 24h).
RIOT_API_KEY=
RIOT_REQUEST_TIMEOUT_MS=8000
RIOT_MAX_CONCURRENCY=4
RIOT_MAX_RETRIES=3

# --- Administrative access ---------------------------------------------------
# Required in production. Minimum 24 characters. Sent as the `x-internal-api-key` header.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_INTERNAL_API_KEY=

# --- Persistence -------------------------------------------------------------
# `filesystem` for local development/Docker. It must point to a directory that survives restarts.
STORAGE_DRIVER=filesystem
CHALLENGE_DATA_DIR=./data

# For the Vercel backend project, create and connect a PRIVATE Vercel Blob store, then set:
# STORAGE_DRIVER=vercel-blob
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# This token must never be exposed in the frontend project.
BLOB_READ_WRITE_TOKEN=

# --- Read models -------------------------------------------------------------
PUBLIC_CACHE_TTL_SECONDS=30

# --- HTTP --------------------------------------------------------------------
# Comma separated list of allowed browser origins. Use `*` to allow any origin.
CORS_ORIGINS=http://localhost:3000
PUBLIC_RATE_LIMIT=120
PUBLIC_RATE_LIMIT_TTL_SECONDS=60
REQUEST_BODY_LIMIT=64kb

# --- Features ----------------------------------------------------------------
# Scheduled synchronization. Set to `false` in Vercel: Vercel Cron invokes the protected
# `/api/v1/cron/synchronization` route instead of relying on an in-process timer.
SYNC_ENABLED=true
SWAGGER_ENABLED=true

# Required by the Vercel Cron endpoint. Generate at least 16 random characters.
# Vercel sends it as `Authorization: Bearer <CRON_SECRET>` for each invocation.
CRON_SECRET=
